---
import { siteConfig } from '@/config/site'
import AppleIcon from '@/components/AppleIcon.astro'
---

<header class="flex w-full items-center justify-between gap-4 px-4 py-3">
  <a href="/" class="group flex items-center gap-2.5 rounded-lg outline-offset-2">
    <img
      src="/brand/icon.png"
      alt={siteConfig.name}
      width="32"
      height="32"
      class="size-8 rounded-[9px] shadow-[0_8px_20px_rgb(124_92_250/0.35)]"
      draggable="false"
    />
    <span class="font-display text-[15px] font-semibold tracking-tight text-ink transition-colors group-hover:text-brand-soft">
      {siteConfig.name}
    </span>
  </a>

  <div class="flex items-center gap-1 sm:gap-2">
    <nav class="hidden items-center gap-1 sm:flex" aria-label="Основная">
      <a
        href={siteConfig.paths.documentation}
        class="rounded-full px-3 py-2 text-sm text-mute transition-colors hover:text-ink"
      >
        Документация
      </a>
      <a
        href={siteConfig.paths.privacy}
        class="rounded-full px-3 py-2 text-sm text-mute transition-colors hover:text-ink"
      >
        Конфиденциальность
      </a>
    </nav>

    <a
      href={siteConfig.appStoreUrl}
      class="inline-flex h-8 items-center gap-1.5 rounded-full bg-chip px-3 text-sm font-medium text-chip-ink transition-colors hover:bg-chip-hover"
    >
      <AppleIcon class="-mt-0.5 h-3.5 w-auto shrink-0 fill-current" />
      App Store
    </a>
  </div>
</header>
