---
import { siteConfig } from '@/config/site'
---

<header class="flex w-full items-center justify-between gap-4 px-4 py-3">
  <a href="/" class="group flex items-center gap-2.5 rounded-lg outline-offset-2">
    <img
      src="/app-icon.png"
      alt={siteConfig.name}
      width="32"
      height="32"
      class="size-8 rounded-[9px] shadow-[0_8px_20px_rgb(124_92_250_/_0.35)]"
      draggable="false"
    />
    <span class="font-display text-[15px] font-semibold tracking-tight text-ink transition-colors group-hover:text-white">
      {siteConfig.name}
    </span>
  </a>

  <div class="flex items-center gap-1 sm:gap-2">
    <nav class="hidden items-center gap-1 sm:flex" aria-label="Основная">
      <a
        href={siteConfig.paths.documentation}
        class="rounded-full px-3 py-2 text-sm text-mute transition-colors hover:text-white"
      >
        Документация
      </a>
      <a
        href={siteConfig.paths.privacy}
        class="rounded-full px-3 py-2 text-sm text-mute transition-colors hover:text-white"
      >
        Конфиденциальность
      </a>
    </nav>

    <a
      href={siteConfig.appStoreUrl}
      class="inline-flex h-8 items-center gap-1.5 rounded-full bg-neutral-700 px-3 text-sm font-medium text-white transition-colors hover:bg-neutral-800"
    >
      <svg class="-mt-0.5 h-3.5 w-auto shrink-0 fill-current" viewBox="0 0 814 1000" aria-hidden="true">
        <path
          d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
        ></path>
      </svg>
      App Store
    </a>
  </div>
</header>
