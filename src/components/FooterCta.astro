---
import { siteConfig } from '@/config/site'
---

<section class="cv-auto relative isolate mt-16 flex min-h-[28rem] items-center justify-center px-4 py-20 md:mt-20 lg:mt-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-1/2 -z-10 aspect-square w-[min(698px,100vw-2rem)] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-25 blur-[80px]"
    style="background: linear-gradient(to top right, #61bb46 0%, #fdb827 20%, #f5821f 40%, #e03a3e 60%, #963d97 80%, #7c5cfa 100%)"
  >
  </div>

  <div class="flex max-w-2xl flex-col items-center text-center">
    <img
      src="/app-icon.png"
      alt={`Иконка ${siteConfig.name}`}
      width="80"
      height="80"
      class="size-16 rounded-[18px] shadow-[0_16px_40px_rgb(124_92_250_/_0.4)] sm:size-20 sm:rounded-[22px]"
      draggable="false"
    />
    <h2 class="font-display mt-9 text-2xl font-semibold leading-tight tracking-tight text-balance text-white lg:text-[28px]">
      Для тех, у кого на доке десятки иконок,<br class="hidden sm:block" /> а не три.
    </h2>
    <p class="mt-4 text-sm text-mute">macOS · {siteConfig.tagline}</p>
    <a
      href={siteConfig.appStoreUrl}
      class="mt-7 inline-flex h-12 items-center gap-2 rounded-full bg-neutral-200 px-6 text-base font-semibold text-neutral-950 transition-colors hover:bg-neutral-100 sm:h-14 sm:px-7 sm:text-lg"
    >
      <svg class="-mt-0.5 h-5 w-auto shrink-0 fill-current" viewBox="0 0 814 1000" aria-hidden="true">
        <path
          d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
        ></path>
      </svg>
      Скачать в App Store
    </a>
  </div>
</section>
