---
import { siteConfig } from '@/config/site'

const year = siteConfig.copyrightYear
---

<footer class="flex w-full items-center justify-between gap-4 border-t border-line bg-transparent px-4 py-3">
  <p class="text-sm text-mute">
    <span class="lg:hidden">{siteConfig.name} © {year}</span>
    <span class="hidden lg:inline">{siteConfig.name} © {year} · {siteConfig.tagline}</span>
  </p>
  <nav aria-label="Подвал" class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1">
    <a
      href={siteConfig.paths.documentation}
      class="rounded-full px-1 text-sm text-mute transition-colors hover:text-ink"
    >
      Документация
    </a>
    <a
      href={siteConfig.paths.privacy}
      class="rounded-full px-1 text-sm text-mute transition-colors hover:text-ink"
    >
      Конфиденциальность
    </a>
    <a
      href={siteConfig.supportUrl}
      class="rounded-full px-1 text-sm text-mute transition-colors hover:text-ink"
      target="_blank"
      rel="noopener noreferrer"
    >
      Поддержка
    </a>
  </nav>
</footer>
