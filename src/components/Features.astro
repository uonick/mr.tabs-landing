---
import Screenshot from "@/components/Screenshot.astro";
import type { ScreenshotName } from "@/assets/screenshots";

type Feature = {
  title: string;
  text: string;
  span: string;
  screenshot?: ScreenshotName;
  alt?: string;
};

const features: Feature[] = [
  {
    title: "Сетка",
    text: "Полностью настраивамая сетка, размер и количество ярдов отображаемых приложений.",
    screenshot: "grid",
    alt: "Настройки сетки приложений",
    span: "md:col-span-3",
  },
  {
    title: "Хоткей",
    text: "По умолчанию тот же ⌘Tab. Хочешь другое сочетание - настрой сам любое",
    screenshot: "hotkeys",
    alt: "Настройка горячих клавиш",
    span: "md:col-span-3",
  },
  {
    title: "Приложения, не окна",
    text: "Одна иконка на приложение. Отпустил клавишу, окно откроется без доп движений",
    span: "md:col-span-2",
  },
  {
    title: "Фоновая работа",
    text: "Приложение умеет автозапускаться и не показыватся. Но если нужно, есть иконка.",
    span: "md:col-span-2",
  },
  {
    title: "Ничего не шлёт",
    text: "Без аккаунта, оплаты, подписок и аналитики. Нужен Accessibility.",
    span: "md:col-span-2",
  },
];
---

<section class="cv-auto mt-16 px-4 md:mt-20 lg:mt-28">
  <h2
    class="font-display text-[20px] font-semibold leading-snug tracking-tight text-balance text-ink lg:text-[28px]"
  >
    Замена системного переключателя<br class="hidden sm:block" /> Просто работает
    и не требует лишних настроек
  </h2>
  <p class="mt-4 max-w-2xl text-sm text-pretty text-mute lg:text-base">
    Стандартный переключатель macOS глючный и исправлять это никто не собирается
  </p>

  <div
    class="relative mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-line md:grid-cols-6"
  >
    {
      features.map((feature) => {
        const hasImage = Boolean(feature.screenshot);
        return (
          <article
            class:list={[
              "flex flex-col bg-panel p-4",
              hasImage ? "min-h-72 md:min-h-96" : "min-h-40 justify-end",
              feature.span,
            ]}
          >
            {feature.screenshot && (
              <div class="flex flex-1 items-center justify-center overflow-hidden py-6 md:py-0">
                <Screenshot
                  name={feature.screenshot}
                  alt={feature.alt ?? ""}
                  sizes="(min-width: 768px) 30rem, 92vw"
                  class="max-h-full max-w-120 object-contain"
                />
              </div>
            )}
            <div>
              <h3 class="text-base font-medium tracking-tight text-ink">
                {feature.title}
              </h3>
              <p class="mt-0.5 text-sm leading-5 text-balance text-mute">
                {feature.text}
              </p>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
