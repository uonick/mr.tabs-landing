---
type Props = {
  title: string
  lead?: string
}

const { title, lead } = Astro.props
---

<main class="px-4 py-14 sm:py-16">
  <article class="mx-auto max-w-2xl">
    <h1 class="font-display text-3xl font-semibold tracking-tight text-ink">{title}</h1>
    {
      lead && (
        <p class="mt-4 text-base leading-7 text-mute">{lead}</p>
      )
    }
    <div class="mt-10 space-y-10 text-sm leading-6 text-mute">
      <slot />
    </div>
  </article>
</main>
