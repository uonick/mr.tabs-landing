---
type Props = {
  title: string
  lead?: string
}

const { title, lead } = Astro.props
---

<main class="px-4 py-14 sm:py-16">
  <article class="mx-auto max-w-2xl">
    <h1 class="font-display text-3xl font-semibold tracking-tight text-white">{title}</h1>
    {
      lead && (
        <p class="mt-4 text-base leading-7 text-mute">{lead}</p>
      )
    }
    <div class="prose-page mt-10 space-y-10 text-sm leading-6 text-mute">
      <slot />
    </div>
  </article>
</main>

<style>
  .prose-page :global(h2) {
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: #fafafa;
  }

  .prose-page :global(h3) {
    margin: 1.25rem 0 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #e5e5e5;
  }

  .prose-page :global(p + p) {
    margin-top: 0.75rem;
  }

  .prose-page :global(ul) {
    margin-top: 0.75rem;
    list-style: disc;
    padding-left: 1.25rem;
  }

  .prose-page :global(li + li) {
    margin-top: 0.4rem;
  }

  .prose-page :global(a) {
    color: var(--color-brand-soft);
    text-underline-offset: 2px;
  }

  .prose-page :global(a:hover) {
    text-decoration: underline;
  }

  .prose-page :global(kbd) {
    display: inline-block;
    border-radius: 0.375rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.06);
    padding: 0.1rem 0.4rem;
    font-size: 0.75rem;
    color: #f5f5f5;
  }

  .prose-page :global(nav.toc) {
    border-radius: 1rem;
    border: 1px solid rgb(255 255 255 / 0.06);
    background: rgb(255 255 255 / 0.02);
    padding: 1rem 1.1rem;
  }

  .prose-page :global(nav.toc a) {
    display: block;
    padding: 0.2rem 0;
    color: var(--color-mute);
  }

  .prose-page :global(nav.toc a:hover) {
    color: #fafafa;
  }
</style>
