---
import { siteConfig } from '@/config/site'
import AppleIcon from '@/components/AppleIcon.astro'
import Screenshot from '@/components/Screenshot.astro'
---

<section class="px-4">
  <p class="animate-rise font-display mt-14 text-sm font-semibold tracking-tight text-brand-soft sm:mt-16">
    {siteConfig.name}
  </p>
  <h1
    class="animate-rise-delay font-display mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance text-white lg:text-4xl"
  >
    Видишь все приложения.<br class="hidden sm:block" /> Переключаешься сразу.
  </h1>
  <p class="animate-rise-late mt-4 max-w-2xl text-base text-balance text-mute lg:text-lg">
    {siteConfig.description}
  </p>
  <a
    href={siteConfig.appStoreUrl}
    class="animate-rise-late mt-8 inline-flex h-12 w-fit items-center gap-2 rounded-full bg-neutral-200 px-6 text-base font-semibold text-neutral-950 transition-colors hover:bg-neutral-100 sm:h-14 sm:px-7 sm:text-lg"
  >
    <AppleIcon />
    Скачать бесплатно
  </a>

  <div class="animate-float mt-9">
    <Screenshot
      lightSrc="/images/settings-light.png"
      darkSrc="/images/settings-dark.png"
      alt="Окно настроек mr.tabs: Accessibility, сетка и ⌘Tab"
      loading="eager"
      fetchpriority="high"
      width={2024}
      height={1568}
      class="w-full"
    />
  </div>
  <p class="mx-2 mt-2 text-xs text-mute">macOS · полностью бесплатно · без аккаунта</p>
</section>
