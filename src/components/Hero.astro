---
import { siteConfig } from '@/config/site'
import AppleIcon from '@/components/AppleIcon.astro'
import Screenshot from '@/components/Screenshot.astro'
---

<section class="flex flex-col items-center px-4 text-center">
  <h1
    class="animate-rise font-display mt-14 max-w-3xl text-3xl font-semibold tracking-tight text-balance text-ink sm:mt-16 lg:text-4xl"
  >
    {siteConfig.headline[0]}
    <br class="hidden sm:block" />
    {siteConfig.headline[1]}
  </h1>
  <p class="animate-rise-late mt-4 max-w-2xl text-base text-balance text-mute lg:text-lg">
    {siteConfig.lead}
  </p>
  <a
    href={siteConfig.downloadUrl}
    download
    class="animate-rise-late mt-8 inline-flex h-12 w-fit items-center gap-2 rounded-full bg-cta px-6 text-base font-semibold text-cta-ink transition-colors hover:bg-cta-hover sm:h-14 sm:px-7 sm:text-lg"
  >
    <AppleIcon />
    Скачать бесплатно
  </a>

  <div class="animate-float mt-12 w-full max-w-2xl px-2 sm:mt-14 sm:max-w-3xl sm:px-4">
    <Screenshot
      name="grid"
      alt="Сетка запущенных приложений в mr.tabs вместо системной полоски ⌘Tab"
      loading="eager"
      fetchpriority="high"
      sizes="(min-width: 640px) 48rem, 92vw"
      class="w-full"
    />
  </div>
  <p class="mt-3 text-xs text-mute">macOS · бесплатно · без аккаунта</p>
</section>
