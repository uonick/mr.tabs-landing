---
import { siteConfig } from '@/config/site'
import Screenshot from '@/components/Screenshot.astro'
---

<section class="px-4">
  <p class="animate-rise font-display mt-14 text-sm font-semibold tracking-tight text-brand-soft sm:mt-16">
    {siteConfig.name}
  </p>
  <h1
    class="animate-rise-delay font-display mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance text-white lg:text-4xl"
  >
    Тот же ⌘Tab.<br class="hidden sm:block" /> Только все приложения сразу на экране.
  </h1>
  <p class="animate-rise-late mt-4 max-w-2xl text-base text-balance text-mute lg:text-lg">
    {siteConfig.description}
  </p>
  <a
    href={siteConfig.appStoreUrl}
    class="animate-rise-late mt-8 inline-flex h-12 w-fit items-center gap-2 rounded-full bg-neutral-200 px-6 text-base font-semibold text-neutral-950 transition-colors hover:bg-neutral-100 sm:h-14 sm:px-7 sm:text-lg"
  >
    <svg class="-mt-0.5 h-5 w-auto shrink-0 fill-current" viewBox="0 0 814 1000" aria-hidden="true">
      <path
        d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
      ></path>
    </svg>
    Скачать в App Store
  </a>

  <div class="animate-float mt-9">
    <Screenshot
      lightSrc="/images/settings-light.png"
      darkSrc="/images/settings-dark.png"
      alt="Окно настроек mr.tabs: Accessibility, сетка и ⌘Tab"
      loading="eager"
      fetchpriority="high"
      width={2024}
      height={1568}
      class="w-full"
    />
  </div>
  <p class="mx-2 mt-2 text-xs text-mute">macOS · перехват ⌘Tab · без аккаунта</p>
</section>
